.DS_Store

# VSCode/Windsurf
.vscode

# Swift
/.swiftpm
/.build
/Packages
/*.xcodeproj
xcuserdata/
/.idea

# Ignore smart IDEs
.windsurfrules
.cursorrules

# do not expose npmjs token
.npmrc

# CocoaPods: the version constant that the SwiftPM GenerateVersion build-tool
# plugin generates at build time is generated by ContentBlockerConverter.podspec
# instead, because CocoaPods does not run build-tool plugins.
ContentBlockerConverterVersion.swift
